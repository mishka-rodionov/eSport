<?xml version="1.0" encoding="utf-8"?>
<!--
   Правила для Auto Backup на API 26-30 (на API 31+ действует data_extraction_rules.xml).
   Исключаем те же локальные данные с ПДн — см. комментарий в data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="database" path="competra-db" />
    <exclude domain="database" path="competra-db-wal" />
    <exclude domain="database" path="competra-db-shm" />
    <exclude domain="file" path="datastore/secure_tokens.pb" />
</full-backup-content>
