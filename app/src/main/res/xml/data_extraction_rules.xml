<?xml version="1.0" encoding="utf-8"?>
<!--
   Исключаем из Android Auto Backup (API 31+) локальную Room-БД (содержит email/ФИО/
   телефон/дату рождения и другие персональные данные) и зашифрованное хранилище
   auth-токенов. Приложение offline-first (см. :core:sync) — после восстановления
   на новом устройстве или переустановки данные подтягиваются заново с сервера,
   локальная копия для этого не нужна. Токены не переживут восстановление в любом
   случае: ключ шифрования живёт в AndroidKeyStore и не переносится между устройствами.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="competra-db" />
        <exclude domain="database" path="competra-db-wal" />
        <exclude domain="database" path="competra-db-shm" />
        <exclude domain="file" path="datastore/secure_tokens.pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="competra-db" />
        <exclude domain="database" path="competra-db-wal" />
        <exclude domain="database" path="competra-db-shm" />
        <exclude domain="file" path="datastore/secure_tokens.pb" />
    </device-transfer>
</data-extraction-rules>
