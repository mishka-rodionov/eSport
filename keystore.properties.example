# Скопируй этот файл в keystore.properties (он в .gitignore, не коммитится)
# и заполни реальными значениями после генерации release-keystore
# (см. инструкцию в CLAUDE.md / чате с Claude).
storeFile=/absolute/path/to/competra-upload.jks
storePassword=CHANGE_ME
keyAlias=competra-upload
keyPassword=CHANGE_ME
